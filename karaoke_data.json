{
    "segments": [
        {
            "id": 0,
            "start": 0.0,
            "end": 3.0,
            "text": "各位空大的同學"
        },
        {
            "id": 1,
            "start": 3.0,
            "end": 7.0,
            "text": "那個這兩個月的暑期課程"
        },
        {
            "id": 2,
            "start": 7.0,
            "end": 9.0,
            "text": "大家真的辛苦了呢"
        },
        {
            "id": 3,
            "start": 10.0,
            "end": 12.0,
            "text": "我們的社區啊"
        },
        {
            "id": 4,
            "start": 12.0,
            "end": 14.0,
            "text": "就像是一個甜甜圈"
        },
        {
            "id": 5,
            "start": 16.0,
            "end": 19.0,
            "text": "如果沒有把學習當作和興趣串連"
        },
        {
            "id": 6,
            "start": 19.0,
            "end": 22.0,
            "text": "中間就會空掉一塊呢"
        },
        {
            "id": 7,
            "start": 23.0,
            "end": 27.0,
            "text": "那個是不是這樣說呢"
        },
        {
            "id": 8,
            "start": 27.0,
            "end": 29.0,
            "text": "請容許我"
        },
        {
            "id": 9,
            "start": 30.0,
            "end": 32.0,
            "text": "說幾句心裡話吧"
        },
        {
            "id": 10,
            "start": 34.0,
            "end": 37.0,
            "text": "舊世代的夕陽早就落下了"
        },
        {
            "id": 11,
            "start": 37.0,
            "end": 41.0,
            "text": "我們總是被困在社會的圓形監獄裡"
        },
        {
            "id": 12,
            "start": 41.0,
            "end": 45.0,
            "text": "被別人的目光追趕著拼命跑著呢"
        },
        {
            "id": 13,
            "start": 46.0,
            "end": 50.0,
            "text": "以為只要考了高分就能得到幸福"
        },
        {
            "id": 14,
            "start": 50.0,
            "end": 51.0,
            "text": "可是"
        },
        {
            "id": 15,
            "start": 51.0,
            "end": 54.0,
            "text": "歲月就這樣流逝著"
        },
        {
            "id": 16,
            "start": 54.0,
            "end": 57.0,
            "text": "才發現只有競爭的人生"
        },
        {
            "id": 17,
            "start": 57.0,
            "end": 61.0,
            "text": "其實是很孤單的"
        },
        {
            "id": 18,
            "start": 63.0,
            "end": 65.0,
            "text": "當你覺得流體智力"
        },
        {
            "id": 19,
            "start": 65.0,
            "end": 67.0,
            "text": "漸漸消退的時候"
        },
        {
            "id": 20,
            "start": 67.0,
            "end": 69.0,
            "text": "這並不代表"
        },
        {
            "id": 21,
            "start": 69.0,
            "end": 72.0,
            "text": "我們的生命失去光芒喔"
        },
        {
            "id": 22,
            "start": 72.0,
            "end": 75.0,
            "text": "因為你這半生跌跌撞撞"
        },
        {
            "id": 23,
            "start": 75.0,
            "end": 78.0,
            "text": "累積下來的晶體智力"
        },
        {
            "id": 24,
            "start": 78.0,
            "end": 80.0,
            "text": "正散發著"
        },
        {
            "id": 25,
            "start": 80.0,
            "end": 83.0,
            "text": "無比溫柔的共感呢"
        },
        {
            "id": 26,
            "start": 84.0,
            "end": 86.0,
            "text": "把人生的挫折"
        },
        {
            "id": 27,
            "start": 86.0,
            "end": 88.0,
            "text": "當作一場沒有壓力的"
        },
        {
            "id": 28,
            "start": 89.0,
            "end": 92.0,
            "text": "行動與反思的實驗吧"
        },
        {
            "id": 29,
            "start": 94.0,
            "end": 95.0,
            "text": "啊"
        },
        {
            "id": 30,
            "start": 95.0,
            "end": 99.0,
            "text": "這一百年的人生"
        },
        {
            "id": 31,
            "start": 99.0,
            "end": 105.0,
            "text": "真的不用再害怕失敗了"
        },
        {
            "id": 32,
            "start": 107.0,
            "end": 110.0,
            "text": "帶著滿身的傷痕"
        },
        {
            "id": 33,
            "start": 110.0,
            "end": 114.0,
            "text": "去擁抱這個世界吧"
        },
        {
            "id": 34,
            "start": 114.0,
            "end": 117.0,
            "text": "請將你那份溫柔的共感"
        },
        {
            "id": 35,
            "start": 118.0,
            "end": 121.0,
            "text": "化作理解他人的星光"
        },
        {
            "id": 36,
            "start": 121.0,
            "end": 124.0,
            "text": "去成為某個人"
        },
        {
            "id": 37,
            "start": 125.0,
            "end": 128.0,
            "text": "心靈依賴的故鄉吧"
        },
        {
            "id": 38,
            "start": 129.0,
            "end": 131.0,
            "text": "這份微小的溫暖"
        },
        {
            "id": 39,
            "start": 132.0,
            "end": 135.0,
            "text": "也就是我們說的關懷"
        },
        {
            "id": 40,
            "start": 135.0,
            "end": 138.0,
            "text": "下一代今夜"
        },
        {
            "id": 41,
            "start": 138.0,
            "end": 142.0,
            "text": "就讓我們為這份勇敢"
        },
        {
            "id": 42,
            "start": 143.0,
            "end": 146.0,
            "text": "掉一次眼淚吧"
        },
        {
            "id": 43,
            "start": 147.0,
            "end": 149.0,
            "text": "在少生少死的時代"
        },
        {
            "id": 44,
            "start": 150.0,
            "end": 152.0,
            "text": "看著那棺材型的人口圖"
        },
        {
            "id": 45,
            "start": 153.0,
            "end": 155.0,
            "text": "其實一點也不用害怕的哦"
        },
        {
            "id": 46,
            "start": 156.0,
            "end": 158.0,
            "text": "因為這證明了"
        },
        {
            "id": 47,
            "start": 158.0,
            "end": 162.0,
            "text": "我們大家都拼盡全力活到了最後啊"
        },
        {
            "id": 48,
            "start": 163.0,
            "end": 165.0,
            "text": "我們都不是完美的個體"
        },
        {
            "id": 49,
            "start": 166.0,
            "end": 168.0,
            "text": "而是為了填補彼此的缺口"
        },
        {
            "id": 50,
            "start": 168.0,
            "end": 172.0,
            "text": "才相遇的動態拼圖啊"
        },
        {
            "id": 51,
            "start": 173.0,
            "end": 176.0,
            "text": "只要我們重新把學習當作核心"
        },
        {
            "id": 52,
            "start": 177.0,
            "end": 179.0,
            "text": "甜甜圈那空掉的中心"
        },
        {
            "id": 53,
            "start": 180.0,
            "end": 183.0,
            "text": "就會在此把我們緊緊串聯在一起"
        },
        {
            "id": 54,
            "start": 184.0,
            "end": 186.0,
            "text": "去成為某個人"
        },
        {
            "id": 55,
            "start": 187.0,
            "end": 189.0,
            "text": "心靈依賴的故鄉吧"
        },
        {
            "id": 56,
            "start": 189.0,
            "end": 193.0,
            "text": "真的不需要再向誰證明什麼了"
        },
        {
            "id": 57,
            "start": 194.0,
            "end": 197.0,
            "text": "你們已經足夠好了"
        },
        {
            "id": 58,
            "start": 199.0,
            "end": 203.0,
            "text": "啊 這一百年的人生"
        },
        {
            "id": 59,
            "start": 204.0,
            "end": 210.0,
            "text": "真的不用再害怕失敗了哦"
        },
        {
            "id": 60,
            "start": 212.0,
            "end": 215.0,
            "text": "帶著滿身的傷痕"
        },
        {
            "id": 61,
            "start": 216.0,
            "end": 219.0,
            "text": "去擁抱這個世界吧"
        },
        {
            "id": 62,
            "start": 220.0,
            "end": 223.0,
            "text": "讓那份微小的溫暖"
        },
        {
            "id": 63,
            "start": 223.0,
            "end": 227.0,
            "text": "化作恩送的光芒"
        },
        {
            "id": 64,
            "start": 228.0,
            "end": 230.0,
            "text": "給未來的世代"
        },
        {
            "id": 65,
            "start": 230.0,
            "end": 236.0,
            "text": "永遠地傳遞下去哦"
        },
        {
            "id": 66,
            "start": 237.0,
            "end": 238.0,
            "text": "發揮我們的本能"
        },
        {
            "id": 67,
            "start": 239.0,
            "end": 241.0,
            "text": "去成為別人的依靠吧"
        },
        {
            "id": 68,
            "start": 242.0,
            "end": 244.0,
            "text": "年輕的時代啊"
        },
        {
            "id": 69,
            "start": 244.0,
            "end": 247.0,
            "text": "還有各位親愛的同學們"
        },
        {
            "id": 70,
            "start": 249.0,
            "end": 250.0,
            "text": "未來的路"
        },
        {
            "id": 71,
            "start": 251.0,
            "end": 252.0,
            "text": "那個"
        },
        {
            "id": 72,
            "start": 253.0,
            "end": 255.0,
            "text": "還請多多指教了"
        },
        {
            "id": 73,
            "start": 256.0,
            "end": 258.0,
            "text": "這短短兩個月"
        },
        {
            "id": 74,
            "start": 259.0,
            "end": 260.0,
            "text": "謝謝你們"
        }
    ]
}